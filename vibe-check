def _load_config(target_dir):
    """Load .vibecheckrc (JSON) from target_dir if it exists.

    Schema:
      {"rules": {"rule-id": "off"|"warn"|"error", ...}}

    Returns a dict (empty if no config file found or parse error).
    """
    for name in (".vibecheckrc", ".vibe-check.json"):
        cfg_path = target_dir / name
        if cfg_path.is_file():
            try:
                return json.loads(cfg_path.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError):
                return {}
    return {}


# ── Findings cache ──────────────────────────────────────────────────────────────
# Cache format v2.
#
# v1 stored only {path: sha256} and did a bare `continue` on a hash hit, so an
# unchanged file contributed ZERO findings to the run. Scanning the same code
# twice gave two different verdicts (25 errors, then 15), which made pass/fail a
# function of run history rather than of the code. A gate that passes on the
# second try is worse than no gate.
#
# v2 stores the findings themselves and replays them on a hit, so a cached run
# and a --no-cache run always report identically. The cache is also keyed on the
# tool source and the resolved config, so adding or re-severing a rule
# invalidates every previously-cached file instead of silently never firing.
CACHE_VERSION = 2

# Rules deduplicated project-wide (one finding per project, whichever file the
# walk reaches first). Replaying one from cache would not repopulate the dedup
# set, so a later real scan could emit a second copy. Files carrying one are
# therefore never cached and are always re-scanned.
_UNCACHEABLE_RULES = {'missing-security-headers', 'no-rate-limiting'}

_tool_sig_cache = None


def _cache_dir():
    """Per-user cache directory. Never inside the scanned project.

    v1 wrote .vibe-check-cache.json into the project root, where it showed up as
    an untracked file in everyone's git status.
    """
    override = os.environ.get("VIBE_CHECK_CACHE_DIR")
    if override:
        return Path(override)
    xdg = os.environ.get("XDG_CACHE_HOME")
    if xdg:
        return Path(xdg) / "vibe-check"
    if os.name == "nt":
        local = os.environ.get("LOCALAPPDATA")
        if local:
            return Path(local) / "vibe-check" / "cache"
    return Path.home() / ".cache" / "vibe-check"


def _cache_path_for(target_dir):
    """Cache file for one project. Name keeps the directory name for readability,
    the hash keeps two same-named projects in different places apart."""
    resolved = str(target_dir.resolve())
    digest = hashlib.sha256(resolved.encode("utf-8")).hexdigest()[:12]
    slug = re.sub(r'[^A-Za-z0-9._-]', '_', target_dir.resolve().name) or "project"
    return _cache_dir() / f"{slug}-{digest}.json"


def _tool_signature():
    """Hash of this script, so shipping a new or changed rule invalidates the cache.

    Falls back to the version string if the source is unreadable (frozen binary,
    odd loader) — degraded but never fatal.
    """
    global _tool_sig_cache
    if _tool_sig_cache is None:
        try:
            _tool_sig_cache = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
        except Exception:
            _tool_sig_cache = f"version:{__version__}"
    return _tool_sig_cache


def _config_signature(config, is_prod):
    """Hash of everything besides file content that changes what a scan reports."""
    payload = json.dumps({"config": config, "prod": bool(is_prod)}, sort_keys=True)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def _load_findings_cache(target_dir, config, is_prod):
    """Return the cached {path: {hash, findings}} map, or {} if unusable.

    Any signature mismatch discards the whole cache rather than trusting part of
    it: a half-valid cache is what produced the original bug.
    """
    try:
        path = _cache_path_for(target_dir)
        if not path.exists():
            return {}
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            return {}
        if data.get("version") != CACHE_VERSION:
            return {}
        if data.get("tool_sig") != _tool_signature():
            return {}
        if data.get("config_sig") != _config_signature(config, is_prod):
            return {}
        files = data.get("files")
        return files if isinstance(files, dict) else {}
    except Exception:
        return {}


def _save_findings_cache(target_dir, files, config, is_prod):
    """Best-effort write. A cache that cannot be written must never fail a scan."""
    try:
        path = _cache_path_for(target_dir)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps({
            "version": CACHE_VERSION,
            "tool_sig": _tool_signature(),
            "config_sig": _config_signature(config, is_prod),
            "files": files,
        }), encoding="utf-8")
    except Exception:
        pass


def _remove_legacy_cache(target_dir):
    """Delete the v1 in-project cache file. It is ours, it is stale, and it is
    the reason projects had an untracked .vibe-check-cache.json lying around."""
    try:
        legacy = target_dir / ".vibe-check-cache.json"
        if legacy.is_file():
            legacy.unlink()
    except Exception:
        pass


# ── Shared helpers (extracted from repeated patterns in check_file_content) ──────

def _line_of(content, pos):
    """Return 1-based line number of a position in content."""
    return content[:pos].count('\n') + 1


def _is_comment(content, pos):
    """True if the position is on a line that starts with a comment marker."""
    line_start = content.rfind('\n', 0, pos) + 1
    prefix = content[line_start:pos].strip()
    return prefix.startswith(('//', '#', '*', '<!--'))


def _is_test_path(file_path):
    """True if the file path indicates test/mock/fixture code."""
    fp_lower = str(file_path).lower()
    return any(t in fp_lower for t in (
        '/test/', '/tests/', '__tests__', '__mocks__',
        '/mock/', '/fixture/', '.test.', '.spec.',
    ))


def _strip_comments(content):
    """Return content with comment-only lines removed."""
    return '\n'.join(
        l for l in content.split('\n')
        if not l.lstrip().startswith(('//', '#', '*', '/*'))
    )


def _jsx_tag_body(content, pos, max_len=512):
    """Extract the body of a JSX/HTML tag starting at pos, tracking brace depth.
    Returns the tag text up to the closing > (or up to max_len chars if no close found)."""
    ahead = content[pos:pos + max_len]
    depth = 0
    for i, ch in enumerate(ahead):
        if ch == '{':
            depth += 1
        elif ch == '}':
            depth -= 1
        elif ch == '>' and depth == 0:
            return ahead[:i]
    return ahead


def _comment_prefixes():
    """Return the set of comment-start strings used across languages."""
    return ('//', '#', '*', '<!--')


class SimpleHTMLInspector(HTMLParser):
    def __init__(self):
        super().__init__()
        self.title = ""
        self.in_title = False
        self.h1_count = 0
        self.in_h1 = False
        self.has_meta_desc = False
        self.has_og_image = False
        self.has_canonical = False
        self.has_favicon = False
        self.is_default_favicon = False
        self.has_lang = False
        self.images_missing_alt = 0
        self.broken_hash_buttons = 0

    def handle_starttag(self, tag, attrs):
        attrs_dict = dict(attrs)
        
        if tag == "html":
            if "lang" in attrs_dict and attrs_dict["lang"].strip():
                self.has_lang = True

        elif tag == "title":
            self.in_title = True

        elif tag == "h1":
            self.h1_count += 1
            self.in_h1 = True

        elif tag == "meta":
            name = attrs_dict.get("name", "").lower()
            prop = attrs_dict.get("property", "").lower()
            content = attrs_dict.get("content", "").strip()
            if name == "description" and content:
                self.has_meta_desc = True
            if prop == "og:image" and content:
                self.has_og_image = True

        elif tag == "link":
            rel = attrs_dict.get("rel", "").lower()
            href = attrs_dict.get("href", "").lower()
            if "canonical" in rel:
                self.has_canonical = True
            if "icon" in rel:
                self.has_favicon = True
                if "vite.svg" in href or "react.svg" in href or "favicon.ico" in href:
                    self.is_default_favicon = True

        elif tag == "img":
            alt = attrs_dict.get("alt", None)
            if alt is None or not alt.strip():
                self.images_missing_alt += 1

        elif tag in ("a", "button"):
            href = attrs_dict.get("href", "")
            onclick = attrs_dict.get("onclick", "")
            if href == "#" and not onclick:
                self.broken_hash_buttons += 1

    def handle_endtag(self, tag):
        if tag == "title":
            self.in_title = False
        elif tag == "h1":
            self.in_h1 = False

    def handle_data(self, data):
        if self.in_title:
            self.title += data

def check_file_content(file_path: Path, fix: bool = False, config: dict = None):
    errors = []
    warnings = []

    def _sev(rule_id, default):
        """Resolve effective severity: 'error', 'warn', or 'off'."""
        if config is None:
            return default
        return config.get('rules', {}).get(rule_id, default)

    try:
        content = file_path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        return errors, warnings

    is_test_file = _is_test_path(file_path)

    # Check 1: Em-dashes (U+2014)
    if not is_test_file:
        em_dash_matches = list(re.finditer(r"—", content))
        if em_dash_matches:
            sev = _sev('em-dashes', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('em-dashes', sev,
                        f"Found {len(em_dash_matches)} em-dash ('—') character(s). "
                        f"Replace with comma (preferred) or standard dash '-'.", fixable=True)
                )
                if fix:
                    content = content.replace("—", ", ")
                    file_path.write_text(content, encoding="utf-8")
                    warnings.append(Finding('em-dashes', 'warn',
                        "Auto-fixed em-dashes by replacing with commas.", fixable=True))

    # Check 1b: Double hyphens used as em-dash replacement (-- in prose)
    # Pattern: word, space(s), --, space(s), word — the classic AI slop
    # "like this -- it means" but NOT "--fix", "i--", "<!--", "-->", "----"
    # Skipped for .sql: "--" is SQL's native line-comment syntax, so this
    # would false-positive on virtually every commented migration file.
    dd_matches = list(re.finditer(r'\w\s+--\s+\w', content)) if file_path.suffix != '.sql' else []
    if dd_matches:
        # Filter out false positives: HTML comments, CLI flags, decrement
        real = []
        for m in dd_matches:
            ctx = content[max(0, m.start()-2):m.end()+2]
            if '<!--' in ctx or '-->' in ctx:
                continue
            real.append(m)
        if real:
            sev = _sev('double-dash', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('double-dash', sev,
                        f"Found {len(real)} double hyphen(s) ('--') used as dash in prose. "
                        f"Replace with comma or single '-'.", fixable=True)
                )
                if fix:
                    content = re.sub(r'(\w)\s+--\s+(\w)', r'\1, \2', content)
                    file_path.write_text(content, encoding="utf-8")
                    warnings.append(Finding('double-dash', 'warn',
                        "Auto-fixed double hyphens by replacing with commas.", fixable=True))

    # Check 2: Hardcoded vercel.app URLs
    if "vercel.app" in content and not file_path.name.endswith(".md"):
        sev = _sev('vercel-urls', 'error')
        if sev != 'off':
            (errors if sev == 'error' else warnings).append(
                Finding('vercel-urls', sev,
                    "Hardcoded 'vercel.app' URL detected in source code.")
            )

    # Check 3: Leftover AI builder watermarks
    # Skip .md files — documentation naturally references these by name.
    if not file_path.suffix == '.md':
        sev = _sev('ai-watermarks', 'error')
        if sev != 'off':
            watermarks = ["Made with Lovable", "Created with v0", "built with bolt.new"]
            for wm in watermarks:
                if wm.lower() in content.lower():
                    (errors if sev == 'error' else warnings).append(
                        Finding('ai-watermarks', sev,
                            f"Leftover AI builder watermark detected: '{wm}'")
                    )

    # Check 4: Placeholder text & fake reviews
    # Skip .md files — documentation naturally lists these as examples.
    if not file_path.suffix == '.md':
        sev = _sev('placeholder-copy', 'warn')
        if sev != 'off':
            placeholders = ["John Doe", "Jane Smith", "Trusted by 10,000+ creators", "Lorem ipsum"]
            for ph in placeholders:
                if ph in content:
                    (errors if sev == 'error' else warnings).append(
                        Finding('placeholder-copy', sev,
                            f"Placeholder copy detected: '{ph}'")
                    )

    # Check 5: Cursive/script font imports
    if not file_path.suffix == '.md':
        sev = _sev('script-fonts', 'warn')
        if sev != 'off':
            script_fonts = ["Dancing+Script", "Pacifico", "Great+Vibes", "Satisfy", "Caveat"]
            for font in script_fonts:
                if font in content:
                    (errors if sev == 'error' else warnings).append(
                        Finding('script-fonts', sev,
                            f"Cursive/script font import detected: '{font}'")
                    )

    # Check 6: Unstyled <select> elements (TSX/JSX only).
    if file_path.suffix in (".tsx", ".jsx"):
        unstyled = []
        for match in re.finditer(r'<\s*select\b', content):
            pos = match.start()
            tag_body = _jsx_tag_body(content, pos, 512)
            if 'className' not in tag_body:
                line_num = _line_of(content, pos)
                if not _is_comment(content, pos):
                    unstyled.append(str(line_num))
        if unstyled:
            sev = _sev('unstyled-selects', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('unstyled-selects', sev,
                        f"Found {len(unstyled)} unstyled <select> element(s) (lines {', '.join(unstyled)}). "
                        f"Use a styled select component instead of raw <select> "
                        f"to ensure consistent theming and custom styling.")
                )

    # Check 7: dangerouslySetInnerHTML (TSX/JSX only) — ERROR.
    if file_path.suffix in (".tsx", ".jsx"):
        if "dangerouslySetInnerHTML" in content:
            sev = _sev('dangerously-set-html', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('dangerously-set-html', sev,
                        "Found dangerouslySetInnerHTML — an XSS vector. "
                        "Use a safe renderer or properly sanitize content before injection.")
                )

    # Check 8: target="_blank" without rel="noopener noreferrer" (HTML/JSX/TSX) — ERROR.
    if file_path.suffix in (".html", ".htm", ".tsx", ".jsx"):
        blank_targets = list(re.finditer(
            r'target\s*=\s*["\']_blank["\']|target\s*=\s*\{["\']_blank["\']\}',
            content
        ))
        insecure = []
        for match in blank_targets:
            start = max(0, match.start() - 32)
            end = min(len(content), match.end() + 256)
            window = content[start:end]
            if 'noopener' not in window:
                line_num = content[:match.start()].count('\n') + 1
                insecure.append(str(line_num))
        if insecure:
            sev = _sev('target-blank-noopener', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('target-blank-noopener', sev,
                        f"Found {len(insecure)} target=\"_blank\" link(s) without "
                        f"rel=\"noopener noreferrer\" (lines {', '.join(insecure)}). "
                        f"Add rel=\"noopener noreferrer\" to prevent tab-napping attacks.")
                )

    # Check 9: console.log in frontend code (.tsx only) — WARN.
    if file_path.suffix in (".tsx",):
        log_matches = list(re.finditer(r'\bconsole\.log\b', content))
        if log_matches:
            sev = _sev('console-log', 'warn')
            if sev != 'off':
                lines = sorted(set(
                    str(content[:m.start()].count('\n') + 1) for m in log_matches
                ))
                (errors if sev == 'error' else warnings).append(
                    Finding('console-log', sev,
                        f"Found {len(log_matches)} console.log() call(s) (lines {', '.join(lines[:10])}"
                        f"{'...' if len(lines) > 10 else ''}). "
                        f"Remove debugging logs before shipping to production.")
                )

    # Check 10: Inline style={{...}} objects (TSX/JSX only) — WARN.
    if file_path.suffix in (".tsx", ".jsx"):
        inline_styles = list(re.finditer(r'\bstyle\s*=\s*\{\{', content))
        if inline_styles:
            sev = _sev('inline-styles', 'warn')
            if sev != 'off':
                lines = sorted(set(
                    str(content[:m.start()].count('\n') + 1) for m in inline_styles
                ))
                (errors if sev == 'error' else warnings).append(
                    Finding('inline-styles', sev,
                        f"Found {len(inline_styles)} inline style={{...}} object(s) (lines {', '.join(lines[:10])}"
                        f"{'...' if len(lines) > 10 else ''}). "
                        f"Use Tailwind classes or CSS modules instead for consistent theming.")
                )

    # Check 11: <img> without alt text (JSX/TSX) — ERROR.
    if file_path.suffix in (".tsx", ".jsx"):
        imgs_missing_alt = 0
        missing_lines = []
        for match in re.finditer(r'<\s*img\b', content):
            pos = match.start()
            tag_body = _jsx_tag_body(content, pos, 512)
            if not re.search(r'\balt\s*=', tag_body):
                line_num = _line_of(content, pos)
                if not _is_comment(content, pos):
                    imgs_missing_alt += 1
                    missing_lines.append(str(line_num))
        if imgs_missing_alt > 0:
            sev = _sev('img-no-alt', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('img-no-alt', sev,
                        f"Found {imgs_missing_alt} <img> element(s) without alt text "
                        f"(lines {', '.join(missing_lines[:10])}"
                        f"{'...' if len(missing_lines) > 10 else ''}). "
                        f"Every image must have descriptive alt text for accessibility.")
                )

    # Check 12: TODO / FIXME / HACK comments — WARN.
    if file_path.suffix in TEXT_EXTENSIONS:
        markers = []
        for match in re.finditer(r'(?://|#|/\*|\*)\s*(TODO|FIXME|HACK)\b', content):
            line_num = content[:match.start()].count('\n') + 1
            markers.append(f"L{line_num}:{match.group(1)}")
        if markers:
            sev = _sev('tech-debt-markers', 'warn')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('tech-debt-markers', sev,
                        f"Found {len(markers)} tech-debt marker(s): {', '.join(markers[:8])}"
                        f"{'...' if len(markers) > 8 else ''}. "
                        f"Resolve or track these before shipping.")
                )

    # Check 13: `as` type casts in TypeScript — WARN.
    # Often used where proper type narrowing would catch edge cases. Flag patterns
    # like `x as SomeType`, `(x as Type)`, `as string`, `as number` but NOT
    # `as const` (which is idiomatic) or common English phrases.
    if file_path.suffix in (".ts", ".tsx"):
        casts = list(re.finditer(
            r'\bas\s+([A-Z]\w+(?:\[\])?|string|number|boolean|object|any|unknown|never|void|null|undefined)\b',
            content
        ))
        # Exclude `as const` (idiomatic TypeScript)
        casts = [c for c in casts if c.group(1) != 'const']
        if casts:
            sev = _sev('as-type-casts', 'warn')
            if sev != 'off':
                lines = sorted(set(
                    str(content[:c.start()].count('\n') + 1) for c in casts
                ))
                (errors if sev == 'error' else warnings).append(
                    Finding('as-type-casts', sev,
                        f"Found {len(casts)} `as` type cast(s) (lines {', '.join(lines[:10])}"
                        f"{'...' if len(lines) > 10 else ''}). "
                        f"Prefer proper type narrowing or type guards over `as` casts "
                        f"which silently bypass type checking."
                    )
                )

    # Check 14: XSS sinks — ERROR.
    # innerHTML/outerHTML assignments, insertAdjacentHTML, document.write,
    # eval(), new Function(), v-html (Vue), and javascript: protocol URLs
    # are the most common XSS vectors in vibecoded projects. Flag as ERROR
    # because legitimate use cases are extremely rare in user-facing code.
    if file_path.suffix in (".js", ".ts", ".tsx", ".jsx", ".vue", ".svelte", ".html", ".htm"):
        xss_sinks = {
            "innerHTML": [r'\.innerHTML\s*='],
            "outerHTML": [r'\.outerHTML\s*='],
            "insertAdjacentHTML": [r'\.insertAdjacentHTML\s*\('],
            "document.write": [r'document\.write\s*\('],
            "eval()": [r'\beval\s*\('],
            "new Function()": [r'new\s+Function\s*\('],
            "v-html (Vue)": [r'v-html\s*='],
            "javascript: URL": [r'(?:href|src|action)\s*=\s*["\x60\'][jJ]avascript:'],
        }
        found = []
        for label, patterns in xss_sinks.items():
            for pat in patterns:
                for m in re.finditer(pat, content):
                    # Skip matches inside comment lines
                    line_start = content.rfind('\n', 0, m.start()) + 1
                    line_prefix = content[line_start:m.start()].strip()
                    if line_prefix.startswith('//') or line_prefix.startswith('*') or line_prefix.startswith('#'):
                        continue
                    # Skip empty-string innerHTML/outerHTML (safe clearing pattern)
                    if label in ("innerHTML", "outerHTML"):
                        after = content[m.end():m.end() + 20].strip()
                        if after.startswith("''") or after.startswith('""') or after.startswith('``'):
                            continue
                        # Skip if nearby content contains esc( — developer is escaping.
                        # Use a generous window (8000 chars) because long template
                        # literals can put interpolations many lines below the
                        # assignment. A shorter window (the old 300) missed safely-
                        # escaped templates in password-manager/autofill.ts.
                        nearby = content[m.end():m.end() + 8000]
                        if 'esc(' in nearby:
                            continue
                        # Skip purely static template literals — no ${...} means
                        # nothing user-controlled can leak in.
                        after_trim = content[m.end():m.end() + 50].lstrip()
                        if after_trim.startswith('`'):
                            tmpl = content[m.end():m.end() + 10000]
                            if '${' not in tmpl:
                                continue
                        # Skip static string assignments (no template interpolation)
                        if after_trim.startswith("'") or after_trim.startswith('"'):
                            continue
                        # Skip known safe renderer functions
                        if re.match(r'[a-zA-Z_]\w*\(', after_trim):
                            func_name = after_trim.split('(')[0]
                            if func_name in ('renderFlags', 'render', 'format', 'sanitize', 'escapeHtml'):
                                continue
                    line_num = content[:m.start()].count('\n') + 1
                    found.append(f"L{line_num}:{label}")
        if found:
            sev = _sev('xss-sinks', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('xss-sinks', sev,
                    f"Found {len(found)} XSS sink(s): {', '.join(found[:10])}"
                    f"{'...' if len(found) > 10 else ''}. "
                    f"Replace innerHTML/outerHTML with textContent or safe DOM APIs; "
                    f"use framework templating instead of v-html/javascript: URLs.")
                )

    # Check 15: File upload security gaps — WARN.
    # Catch three common patterns: <input type="file"> without accept
    # attribute, multer/formidable without fileFilter, and express.static
    # mount points over upload directories.
    if file_path.suffix in (".js", ".ts", ".tsx", ".jsx", ".html", ".htm"):
        upload_gaps = []
        # Pattern A: <input type="file"> without accept attribute (HTML/JSX)
        if file_path.suffix in (".html", ".htm", ".tsx", ".jsx"):
            for m in re.finditer(r'<\s*input\b', content):
                pos = m.start()
                tag_body = _jsx_tag_body(content, pos, 512)
                if re.search(r'type\s*=\s*["\x60\']file["\x60\']', tag_body) and 'accept' not in tag_body:
                    upload_gaps.append(f"L{_line_of(content, pos)}:file-input-no-accept")
        # Pattern B: multer without fileFilter (Node.js)
        if file_path.suffix in (".js", ".ts"):
            for m in re.finditer(r'\bmulter\s*\(', content):
                pos = m.start()
                ahead = content[pos:pos + 1024]
                if 'fileFilter' not in ahead and 'file_filter' not in ahead:
                    line_num = content[:pos].count('\n') + 1
                    upload_gaps.append(f"L{line_num}:multer-no-fileFilter")
        # Pattern C: express.static over a path containing 'upload'
        if file_path.suffix in (".js", ".ts"):
            for m in re.finditer(r'\.static\s*\(', content):
                pos = m.start()
                ahead = content[pos:pos + 256]
                if re.search(r'upload', ahead, re.IGNORECASE):
                    line_num = content[:pos].count('\n') + 1
                    upload_gaps.append(f"L{line_num}:express-static-uploads")
        if upload_gaps:
            sev = _sev('file-upload-gaps', 'warn')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('file-upload-gaps', sev,
                        f"Found {len(upload_gaps)} file-upload security gap(s): "
                        f"{', '.join(upload_gaps[:10])}"
                        f"{'...' if len(upload_gaps) > 10 else ''}. "
                        f"Add accept attribute on file inputs, fileFilter on multer, "
                        f"and consider nosniff headers for upload directories."
                )
            )

    # Check 16: Webhook signature verification gaps — WARN.
    # Detect files that handle webhook routes but don't contain HMAC
    # signature verification in the same file. This is a heuristic —
    # verification could be in a shared middleware or imported module.
    if file_path.suffix in (".js", ".ts", ".py"):
        # First: is this file a webhook handler?
        webhook_indicators = [
            r'webhook', r'/api/webhook', r'"webhook"', r"'webhook'",
        ]
        route_webhook_patterns = [
            r'(?:app|router|@app)\.(?:post|get|put|delete|use)\s*\(\s*["\x60\'][^"\x60\']*webhook',
            r'@(?:app|router)\.(?:post|get|put|delete|route)\s*\(\s*["\x60\'][^"\x60\']*webhook',
        ]
        is_webhook_file = False
        for pat in webhook_indicators:
            if re.search(pat, content, re.IGNORECASE):
                is_webhook_file = True
                break
        # Also check: does the file define a route with "webhook" in the path?
        if not is_webhook_file:
            for pat in route_webhook_patterns:
                if re.search(pat, content, re.IGNORECASE):
                    is_webhook_file = True
                    break
        if is_webhook_file:
            # Verify the file contains signature verification OR alternative auth
            sig_patterns = [
                r'constructEvent',           # Stripe
                r'verifySignature',          # Generic
                r'createHmac',               # Node crypto
                r'timingSafeEqual',          # Node crypto constant-time
                r'\.update\(.*\)\.digest\(', # HMAC digest chain
                r'compare_digest',           # Python hmac constant-time
                r'hmac\.new\(',              # Python HMAC
                r'HMAC\(',                   # Python HMAC class
                r'signature',                # Generic (loose match)
            ]
            # Also accept API key / bearer token auth as valid protection
            alt_auth_patterns = [
                r'require_api_key',          # Custom API key dependency
                r'require_auth',             # Generic auth dependency
                r'api[_-]?key',              # API key reference
                r'x-api-key',                # API key header
                r'Depends\(',                # FastAPI dependency injection (likely auth)
            ]
            has_protection = (
                any(re.search(pat, content, re.IGNORECASE) for pat in sig_patterns)
                or any(re.search(pat, content, re.IGNORECASE) for pat in alt_auth_patterns)
            )
            if not has_protection:
                first_route = None
                for pat in route_webhook_patterns:
                    m = re.search(pat, content, re.IGNORECASE)
                    if m:
                        first_route = content[:m.start()].count('\n') + 1
                        break
                loc = f" (first route near line {first_route})" if first_route else ""
                sev = _sev('unsigned-webhooks', 'warn')
                if sev != 'off':
                    (errors if sev == 'error' else warnings).append(
                        Finding('unsigned-webhooks', sev,
                        f"Webhook handler detected but no HMAC signature verification "
                        f"found in the same file{loc}. Unsigned webhooks accept arbitrary "
                        f"events from anyone. Add HMAC signature verification using "
                        f"crypto.timingSafeEqual (Node) or hmac.compare_digest (Python).")
                    )

    # Check 17: Hardcoded secrets — ERROR.
    # AI assistants inline API keys, DB credentials, and access tokens from
    # tutorial patterns in training data. Apiiro data shows AI-assisted devs
    # expose cloud credentials at nearly 2x the rate of non-AI devs.
    if file_path.suffix in TEXT_EXTENSIONS:
        secret_patterns = [
            ("Stripe live key", r'(?:sk|pk)_live_[0-9a-zA-Z]{24,}'),
            ("Stripe test key", r'(?:sk|pk)_test_[0-9a-zA-Z]{24,}'),
            ("AWS access key", r'AKIA[0-9A-Z]{16}'),
            ("private key block", r'-----BEGIN (?:RSA|EC|DSA|OPENSSH) PRIVATE KEY-----'),
            ("OpenAI API key", r'sk-proj-[0-9a-zA-Z_-]{20,}'),
            ("Anthropic API key", r'sk-ant-(?:api|admin)[0-9a-zA-Z_-]{20,}'),
            ("GitHub token", r'gh[pousr]_[A-Za-z0-9_]{36}'),
            ("SendGrid API key", r'SG\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}'),
            ("password assignment", r'password\s*[:=]\s*["\'][^"\']{4,}["\']'),
            ("secret assignment", r'secret\s*[:=]\s*["\'][^"\']{8,}["\']'),
            ("API key assignment", r'api[_-]?key\s*[:=]\s*["\'][^"\']{8,}["\']'),
            ("JWT secret", r'JWT_SECRET\s*[:=]\s*["\'][^"\']{4,}["\']'),
            ("token assignment", r'token\s*[:=]\s*["\'][A-Za-z0-9+/=]{20,}["\']'),
        ]
        found_secrets = []
        is_md = file_path.suffix == '.md'
        for label, pattern in secret_patterns:
            for m in re.finditer(pattern, content, re.IGNORECASE):
                pos = m.start()
                line_num = content[:pos].count('\n') + 1
                # Skip comment lines
                line_start = content.rfind('\n', 0, pos) + 1
                line_prefix = content[line_start:pos].strip()
                if line_prefix.startswith('//') or line_prefix.startswith('#') or line_prefix.startswith('*') or line_prefix.startswith('<!--'):
                    continue
                if is_test_file or is_md:
                    continue
                # For assignment patterns: check value is not from env, not a placeholder
                if label in ("password assignment", "secret assignment", "API key assignment", "JWT secret", "token assignment"):
                    nearby = content[max(0, pos-20):pos+100]
                    if any(ref in nearby for ref in ('process.env', 'os.environ', 'import.meta.env', 'Deno.env', 'process.env[')):
                        continue
                    val_m = re.search(r'["\']([^"\']{4,})["\']', content[pos:pos+80])
                    if val_m:
                        val_lower = val_m.group(1).lower()
                        if any(p in val_lower for p in ('changeme', 'your-', 'replace', 'xxx', 'todo',
                                                          'example', 'your_api_key', 'YOUR_', 'placeholder', 'dummy')):
                            continue
                if label == "password assignment":
                    pw_m = re.search(r'password\s*[:=]\s*["\']([^"\']*)["\']', content[pos:pos+60])
                    if pw_m and not pw_m.group(1).strip():
                        continue
                found_secrets.append(f"L{line_num}:{label}")
        # DB connection strings with embedded credentials
        # Only match known database URL schemes to avoid false positives on
        # Google Fonts URLs and other web resources with @ signs in params.
        if not is_md:
            db_schemes = r'(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis|amqp|mqtt|sqlserver|oracle|mariadb)'
            for m in re.finditer(rf'({db_schemes})://([^:@\s]{{1,64}}):([^@\s]{{1,128}})@', content, re.IGNORECASE):
                pos = m.start()
                line_start = content.rfind('\n', 0, pos) + 1
                line_prefix = content[line_start:pos].strip()
                if line_prefix.startswith('//') or line_prefix.startswith('#') or line_prefix.startswith('*'):
                    continue
                nearby_db = content[max(0, pos-30):pos+120]
                if any(ref in nearby_db for ref in ('process.env', 'os.environ', 'import.meta.env')):
                    continue
                after_db = content[m.end():m.end()+50]
                if re.match(r'(localhost|127\.0\.0\.1|0\.0\.0\.0)', after_db):
                    continue
                line_num = content[:pos].count('\n') + 1
                found_secrets.append(f"L{line_num}:DB-credentials-in-URL")
        if found_secrets:
            sev = _sev('hardcoded-secrets', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('hardcoded-secrets', sev,
                    f"Found {len(found_secrets)} hardcoded secret(s): "
                    f"{', '.join(found_secrets[:10])}"
                    f"{'...' if len(found_secrets) > 10 else ''}. "
                    f"Move secrets to environment variables or a secrets manager, "
                    f"and rotate any exposed credentials immediately.")
                )

    # Check 18: Broken JWT validation — ERROR.
    # AI assistants copy the shortest jwt.decode() call from docs, which often
    # omits algorithm pinning. Explicitly disabled verification and alg:none
    # acceptance are common.
    if file_path.suffix in (".js", ".ts", ".py"):
        jwt_errors = []
        jwt_warns = []
        jwt_is_test = _is_test_path(file_path)
        # Python: PyJWT misconfigurations
        if file_path.suffix == ".py":
            # ERROR: explicitly disabled verification
            for pat, label in [
                (r'\bverify\s*=\s*False\b', 'verify=False'),
                (r'["\']verify_signature["\']\s*:\s*False', 'verify_signature disabled'),
                (r'\balgorithms\s*=\s*\[["\']none["\']\]', 'algorithms=["none"]'),
                (r'\balgorithms\s*=\s*\[["\']None["\']\]', 'algorithms=["None"]'),
            ]:
                for m in re.finditer(pat, content, re.IGNORECASE):
                    line_start = content.rfind('\n', 0, m.start()) + 1
                    line_prefix = content[line_start:m.start()].strip()
                    if line_prefix.startswith('#'):
                        continue
                    if jwt_is_test:
                        continue
                    ln = content[:m.start()].count('\n') + 1
                    jwt_errors.append(f"L{ln}:{label}")
            # WARN: jwt.decode with 2 positional args and no algorithms=
            for m in re.finditer(r'\bjwt\.decode\s*\(', content):
                pos = m.start()
                line_start = content.rfind('\n', 0, pos) + 1
                if content[line_start:pos].strip().startswith('#'):
                    continue
                if jwt_is_test:
                    continue
                # Find closing paren with brace tracking
                depth = 0
                call_text = ""
                for i, ch in enumerate(content[pos:]):
                    if ch == '(':
                        depth += 1
                    elif ch == ')':
                        depth -= 1
                        if depth == 0:
                            call_text = content[pos:pos+i+1]
                            break
                if 'algorithms=' not in call_text:
                    # Count positional args before first keyword arg
                    args_part = call_text.split('(')[1]
                    # Rough: count commas not inside brackets/parens before first =
                    comma_positions = []
                    bdepth = 0
                    for i, ch in enumerate(args_part):
                        if ch in '([{':
                            bdepth += 1
                        elif ch in ')]}':
                            bdepth -= 1
                        elif ch == ',' and bdepth == 0:
                            comma_positions.append(i)
                        elif ch == '=' and bdepth == 0:
                            break
                    pos_args = len(comma_positions) + 1 if args_part.strip()[:-1].strip() else 0
                    if pos_args <= 2:
                        ln = content[:pos].count('\n') + 1
                        jwt_warns.append(f"L{ln}:jwt.decode-no-algorithms")
        # JavaScript: jsonwebtoken misconfigurations
        if file_path.suffix in (".js", ".ts"):
            for pat, label in [
                (r'\balgorithms\s*:\s*\[["\']none["\']\]', 'algorithms:["none"]'),
                (r'\bignoreExpiration\s*:\s*true\b', 'ignoreExpiration:true'),
                (r'\bjwt\.decode\s*\(', 'jwt.decode (no verify)'),
            ]:
                for m in re.finditer(pat, content, re.IGNORECASE):
                    line_start = content.rfind('\n', 0, m.start()) + 1
                    line_prefix = content[line_start:m.start()].strip()
                    if line_prefix.startswith('//') or line_prefix.startswith('*'):
                        continue
                    if jwt_is_test:
                        continue
                    ln = content[:m.start()].count('\n') + 1
                    if label == 'jwt.decode (no verify)':
                        jwt_warns.append(f"L{ln}:{label}")
                    else:
                        jwt_errors.append(f"L{ln}:{label}")
        if jwt_errors:
            sev = _sev('broken-jwt', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('broken-jwt', sev,
                    f"Found {len(jwt_errors)} broken JWT validation(s): "
                    f"{', '.join(jwt_errors[:8])}"
                    f"{'...' if len(jwt_errors) > 8 else ''}. "
                    f"Always verify JWT signatures with an explicit algorithm allowlist "
                    f"(e.g. algorithms=['RS256']). Never accept alg:none.")
                )
        if jwt_warns:
            sev = _sev('broken-jwt', 'warn')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('broken-jwt', sev,
                    f"Found {len(jwt_warns)} potentially insecure JWT pattern(s): "
                    f"{', '.join(jwt_warns[:8])}"
                    f"{'...' if len(jwt_warns) > 8 else ''}. "
                    f"Use jwt.verify() (not jwt.decode()) and pin algorithm allowlists.")
                )

    # Check 19: Debug mode enabled — WARN.
    # AI generates config with DEBUG=True from templates, never changes it before
    # deploy. Django debug console, Flask debugger, and Express stack traces all
    # leak secrets and sometimes allow code execution.
    if file_path.suffix in (".js", ".ts", ".py"):
        debug_found = []
        dbg_is_test = _is_test_path(file_path)
        if dbg_is_test:
            pass  # skip test files entirely
        elif file_path.suffix == ".py":
            for pat, label in [
                (r'\bDEBUG\s*=\s*True\b', 'DEBUG=True'),
                (r'\bdebug\s*=\s*True\b', 'debug=True'),
                (r'\bAPP_DEBUG\s*=\s*True\b', 'APP_DEBUG=True'),
                (r'\bFLASK_DEBUG\s*=\s*True\b', 'FLASK_DEBUG=True'),
                (r'\bDJANGO_DEBUG\s*=\s*True\b', 'DJANGO_DEBUG=True'),
            ]:
                for m in re.finditer(pat, content):
                    pos = m.start()
                    line_start = content.rfind('\n', 0, pos) + 1
                    line_prefix = content[line_start:pos].strip()
                    if line_prefix.startswith('#'):
                        continue
                    # Skip if guarded by __name__ == "__main__" within 5 lines
                    before_lines = content[max(0, line_start-200):pos].split('\n')
                    recent = '\n'.join(before_lines[-6:])
                    if '__name__' in recent and '__main__' in recent:
                        continue
                    # Skip if reading from env (not setting)
                    if label in ('DEBUG=True', 'APP_DEBUG=True'):
                        nearby = content[max(0, pos-30):pos]
                        if 'os.environ.get' in nearby or 'os.getenv' in nearby:
                            continue
                    ln = content[:pos].count('\n') + 1
                    debug_found.append(f"L{ln}:{label}")
        elif file_path.suffix in (".js", ".ts"):
            for pat, label in [
                (r"\bNODE_ENV\s*[:=]\s*['\"]development['\"]", "NODE_ENV=development"),
                (r"\bprocess\.env\.NODE_ENV\s*=\s*['\"]development['\"]", "NODE_ENV=development"),
            ]:
                for m in re.finditer(pat, content):
                    line_start = content.rfind('\n', 0, m.start()) + 1
                    line_prefix = content[line_start:m.start()].strip()
                    if line_prefix.startswith('//') or line_prefix.startswith('*'):
                        continue
                    ln = content[:m.start()].count('\n') + 1
                    debug_found.append(f"L{ln}:{label}")
        if debug_found:
            sev = _sev('debug-mode', 'warn')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('debug-mode', sev,
                        f"Found {len(debug_found)} debug-mode indicator(s): "
                        f"{', '.join(debug_found[:8])}"
                        f"{'...' if len(debug_found) > 8 else ''}. "
                        f"Disable debug mode in production — debug consoles expose "
                        f"interactive code execution and stack traces with secrets."
                    )
                )

    # Check 20: Unsafe deserialization — ERROR.
    # pickle.loads(), yaml.load() without SafeLoader, and similar functions
    # execute arbitrary code on untrusted input. AI reproduces the shortest
    # call signature from docs, which is the unsafe one.
    if file_path.suffix in (".py", ".js", ".ts"):
        deser_found = []
        deser_is_test = _is_test_path(file_path)
        if file_path.suffix == ".py":
            deser_pats = [
                (r'\bpickle\.loads?\s*\(', 'pickle.loads/load'),
                (r'\bmarshal\.loads?\s*\(', 'marshal.loads'),
                (r'\bdill\.loads?\s*\(', 'dill.loads'),
                (r'\btorch\.load\s*\(', 'torch.load'),
                (r'\byaml\.load\s*\(', 'yaml.load'),
            ]
            for pat, label in deser_pats:
                for m in re.finditer(pat, content):
                    pos = m.start()
                    line_start = content.rfind('\n', 0, pos) + 1
                    line_prefix = content[line_start:pos].strip()
                    if line_prefix.startswith('#'):
                        continue
                    if deser_is_test:
                        continue
                    if label == 'yaml.load':
                        nearby = content[pos:pos+200]
                        if 'SafeLoader' in nearby or 'CSafeLoader' in nearby:
                            continue
                    if label == 'torch.load':
                        nearby = content[pos:pos+200]
                        if 'weights_only' in nearby:
                            continue
                    ln = content[:pos].count('\n') + 1
                    deser_found.append(f"L{ln}:{label}")
        elif file_path.suffix in (".js", ".ts"):
            for m in re.finditer(r'\bvm\.runInNewContext\s*\(', content):
                pos = m.start()
                line_start = content.rfind('\n', 0, pos) + 1
                if content[line_start:pos].strip().startswith('//'):
                    continue
                if deser_is_test:
                    continue
                ln = content[:pos].count('\n') + 1
                deser_found.append(f"L{ln}:vm.runInNewContext")
        if deser_found:
            sev = _sev('unsafe-deserialization', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('unsafe-deserialization', sev,
                    f"Found {len(deser_found)} unsafe deserialization call(s): "
                    f"{', '.join(deser_found[:8])}"
                    f"{'...' if len(deser_found) > 8 else ''}. "
                    f"Use safe parsers: yaml.safe_load(), json.loads(), or isolated "
                    f"execution. pickle.loads() on untrusted input is remote code execution.")
                )

    # Check 21: Math.random() in security-sensitive contexts — WARN.
    # Math.random() is not cryptographically secure. AI assistants frequently
    # reach for it when generating tokens, reset codes, or session IDs because
    # pre-crypto-API patterns dominate training data.
    if file_path.suffix in (".js", ".ts", ".tsx", ".jsx", ".html", ".htm"):
        rand_is_test = _is_test_path(file_path)
        if not rand_is_test:
            security_keywords = [
                'token', 'reset', 'auth', 'password', 'secret', 'session',
                'apiKey', 'api_key', 'csrf', 'nonce', 'otp', 'verify',
                'hash', 'uuid', 'identifier', 'credential', 'code',
            ]
            rand_found = []
            seen_lines = set()
            for m in re.finditer(r'\bMath\.random\s*\(\s*\)', content):
                pos = m.start()
                line_start = content.rfind('\n', 0, pos) + 1
                line_prefix = content[line_start:pos].strip()
                if line_prefix.startswith('//') or line_prefix.startswith('*'):
                    continue
                line_num = content[:pos].count('\n') + 1
                if line_num in seen_lines:
                    continue
                # Check ±2 lines for security keywords
                ctx_start = max(0, line_start - 1)
                ctx_end = min(len(content), content.find('\n', content.find('\n', pos) + 1) + 1)
                if ctx_end <= 0:
                    ctx_end = min(len(content), pos + 200)
                # Expand: get line before and line after
                line_before_start = content.rfind('\n', 0, line_start - 1) + 1 if line_start > 1 else 0
                line_after_end = content.find('\n', pos)
                line_after_end2 = content.find('\n', line_after_end + 1) if line_after_end >= 0 else len(content)
                context_window = content[max(0, line_before_start-1):min(len(content), line_after_end2+1)]
                # Find which keywords appear.
                # Use lookbehind/ahead instead of \b to handle camelCase
                # (e.g. "reset" matches inside "resetToken" since T is uppercase).
                hits = []
                for kw in security_keywords:
                    # Match keyword preceded by non-alpha (or start) and not followed
                    # by lowercase (allows camelCase like resetToken, blocks encodeURI)
                    pat = r'(?<![a-zA-Z])' + re.escape(kw) + r'(?![a-z])'
                    if re.search(pat, context_window, re.IGNORECASE):
                        hits.append(kw)
                if hits:
                    # Skip if same line has crypto API usage (dev chose Math.random intentionally)
                    line_text = content[line_start:content.find('\n', pos)] if content.find('\n', pos) >= 0 else content[line_start:]
                    if 'crypto.randomUUID' in line_text or 'crypto.getRandomValues' in line_text:
                        continue
                    seen_lines.add(line_num)
                    rand_found.append(f"L{line_num}:near-{hits[0]}")
            if rand_found:
                sev = _sev('math-random-security', 'warn')
                if sev != 'off':
                    (errors if sev == 'error' else warnings).append(
                        Finding('math-random-security', sev,
                            f"Found {len(rand_found)} Math.random() in security-sensitive context(s): "
                            f"{', '.join(rand_found[:8])}"
                            f"{'...' if len(rand_found) > 8 else ''}. "
                            f"Math.random() is not cryptographically secure. "
                            f"Use crypto.randomUUID() or crypto.getRandomValues() instead."
                        )
                    )

    # Check 22: Missing security headers — WARN.
    # AI generates route handlers and page templates but omits security headers
    # like CSP, HSTS, X-Frame-Options. In one study, zero of five AI-built apps
    # had any security headers configured.
    if file_path.suffix in (".js", ".ts", ".py"):
        hdr_is_test = _is_test_path(file_path)
        if not hdr_is_test:
            # Strip comments to avoid matching comment lines
            content_nc = _strip_comments(content)
            header_gap = None
            if file_path.suffix in (".js", ".ts"):
                has_express = bool(re.search(r'(?:express\(\)|require\(["\']express["\']\)|from\s+["\']express["\'])', content_nc))
                has_routes = bool(re.search(r'\b(?:app|router)\.(?:get|post|put|delete|patch|use)\s*\(', content_nc))
                has_helmet = 'helmet' in content_nc
                if has_express and has_routes and not has_helmet:
                    header_gap = "Express"
            elif file_path.suffix == ".py":
                has_flask = bool(re.search(r'\bFlask\s*\(\s*__name__', content_nc))
                has_fastapi = 'FastAPI(' in content_nc
                has_routes_py = bool(re.search(r'@(?:app|router)\.(?:route|get|post|put|delete|patch)\s*\(', content_nc))
                has_security_py = bool(re.search(r'\b(Talisman|Secure\s*\(|secure_headers|SecurityMiddleware)', content_nc))
                if has_flask and has_routes_py and not has_security_py:
                    header_gap = "Flask"
                elif has_fastapi and has_routes_py and not has_security_py:
                    header_gap = "FastAPI"
            if header_gap:
                # Deduplicate: only one warning per framework per project
                gap_key = f"sec-headers-{header_gap}"
                if gap_key not in _seen_project_warnings:
                    _seen_project_warnings.add(gap_key)
                    sev = _sev('missing-security-headers', 'warn')
                    if sev != 'off':
                        (errors if sev == 'error' else warnings).append(
                            Finding('missing-security-headers', sev,
                                f"{header_gap} server detected but no security headers "
                                f"middleware found (helmet/Talisman/Secure). Add CSP, HSTS, "
                                f"X-Frame-Options, and X-Content-Type-Options headers."
                            )
                        )

    # Check 23: Potential SSRF via unfiltered user URLs — WARN.
    # URL preview, webhook registration, and image import features often pass
    # user-supplied URLs directly to fetch/axios/requests. AI tools rarely add
    # URL validation or hostname allowlists unless explicitly prompted.
    if file_path.suffix in (".js", ".ts", ".py"):
        ssrf_is_test = _is_test_path(file_path)
        if not ssrf_is_test:
            ssrf_found = []
            # JS/TS: fetch/axios with user-supplied URL
            if file_path.suffix in (".js", ".ts"):
                url_param_names = ['url', 'uri', 'link', 'href', 'src', 'target',
                                   'redirect', 'callback', 'webhook', 'endpoint', 'path', 'resource']
                for client in ('fetch', 'axios\.get', 'axios\.post', 'axios\(', 'got\(', 'nodeFetch\('):
                    for param in url_param_names:
                        pat = rf'\b{client}\s*\(?\s*(?:req|request)\.(?:query|params|body)\.{param}\b'
                        for m in re.finditer(pat, content):
                            pos = m.start()
                            line_start = content.rfind('\n', 0, pos) + 1
                            if content[line_start:pos].strip().startswith('//') or content[line_start:pos].strip().startswith('*'):
                                continue
                            # Check for URL validation nearby
                            ctx = content[max(0, pos-50):pos+200]
                            validation_signal = any(v in ctx for v in ('new URL(', 'urlparse', 'is_valid_url',
                                                   'ALLOWED_HOSTS', 'allowed_hosts', 'allowed_domains', 'urlValidator'))
                            if not validation_signal:
                                ln = content[:pos].count('\n') + 1
                                ssrf_found.append(f"L{ln}:{client.split('(')[0]}-from-request")
                                break  # one match per client/param pair
            # Python: requests/httpx/urllib with user-supplied URL
            if file_path.suffix == ".py":
                for client_pat in [
                    r'\brequests\.(?:get|post|put|delete|patch|head)\s*\(',
                    r'\bhttpx\.(?:get|post|put|delete)\s*\(',
                    r'\burllib\.request\.urlopen\s*\(',
                ]:
                    for m in re.finditer(client_pat, content):
                        pos = m.start()
                        line_start = content.rfind('\n', 0, pos) + 1
                        if content[line_start:pos].strip().startswith('#'):
                            continue
                        # Check if request data flows into URL position
                        nearby_ssrf = content[pos:pos+200]
                        if re.search(r'request\.(?:args|form|json|data)\.(?:get|get\(|\[)', nearby_ssrf) or \
                           re.search(r'url\s*=\s*request\.', nearby_ssrf):
                            # Check for URL validation
                            ctx2 = content[max(0, pos-50):pos+250]
                            if not any(v in ctx2 for v in ('urlparse', 'is_valid_url', 'ALLOWED_HOSTS',
                                                            'allowed_hosts', 'allowed_domains')):
                                ln = content[:pos].count('\n') + 1
                                client_name = re.match(r'\b(\w+(?:\.\w+)*)', client_pat.strip(r'\b').lstrip('\\b'))
                                ssrf_found.append(f"L{ln}:{client_name.group(1)}-from-request")
            if ssrf_found:
                sev = _sev('ssrf-user-urls', 'warn')
                if sev != 'off':
                    (errors if sev == 'error' else warnings).append(
                        Finding('ssrf-user-urls', sev,
                        f"Found {len(ssrf_found)} potential SSRF vector(s): "
                        f"{', '.join(ssrf_found[:8])}"
                        f"{'...' if len(ssrf_found) > 8 else ''}. "
                        f"Validate and sanitize all user-supplied URLs, or use an "
                        f"allowlist of permitted hosts. User-controlled URLs can access "
                        f"internal services and cloud metadata endpoints."
                    )
                )

    # Check 24: No rate limiting configured — WARN.
    # Resource exhaustion was the #1 flaw in Xint.io's 434-flaw audit (93 issues).
    # AI codes happy-path handlers; rate limiting is infrastructure it never adds
    # unless explicitly prompted.
    if file_path.suffix in (".js", ".ts", ".py"):
        rl_is_test = _is_test_path(file_path)
        if not rl_is_test:
            # Strip comments to avoid matching comment lines
            rl_content = _strip_comments(content)
            rl_gap = None
            if file_path.suffix in (".js", ".ts"):
                has_express_rl = bool(re.search(r'(?:express\(\)|require\(["\']express["\']\)|from\s+["\']express["\'])', rl_content))
                has_routes_rl = bool(re.search(r'\b(?:app|router)\.(?:get|post|put|delete|patch)\s*\(', rl_content))
                has_rate_limit = bool(re.search(r'\b(?:rateLimit|express-rate-limit|rate-limiter-flexible|express-slow-down)\b', rl_content))
                if has_express_rl and has_routes_rl and not has_rate_limit and len(content) > 500:
                    rl_gap = "Express"
            elif file_path.suffix == ".py":
                has_fastapi_rl = 'FastAPI(' in rl_content
                has_flask_rl = bool(re.search(r'\bFlask\s*\(\s*__name__', rl_content))
                has_routes_rl_py = bool(re.search(r'@(?:app|router)\.(?:route|get|post|put|delete|patch)\s*\(', rl_content))
                has_rate_limit_py = bool(re.search(r'\b(?:slowapi|Limiter|RateLimiter|flask-limiter|rate_limit)\b', rl_content))
                if (has_fastapi_rl or has_flask_rl) and has_routes_rl_py and not has_rate_limit_py and len(content) > 500:
                    rl_gap = "FastAPI" if has_fastapi_rl else "Flask"
            if rl_gap:
                rl_key = f"rate-limit-{rl_gap}"
                if rl_key not in _seen_project_warnings:
                    _seen_project_warnings.add(rl_key)
                    sev = _sev('no-rate-limiting', 'warn')
                    if sev != 'off':
                        (errors if sev == 'error' else warnings).append(
                            Finding('no-rate-limiting', sev,
                                f"No rate limiting middleware detected in {rl_gap} server. "
                                f"Add rate limiting (express-rate-limit / slowapi / flask-limiter) "
                                f"to prevent brute-force, credential stuffing, and resource exhaustion attacks."
                            )
                        )

    # Check 25: Password inputs missing autocomplete — WARN.
    # Password managers rely on autocomplete attributes to fill, generate,
    # and update credentials. Without them, users are pushed toward weak
    # or reused passwords, and saved credentials can't be updated after a
    # password change. Flag any <input type="password"> missing autocomplete.
    if file_path.suffix in (".html", ".tsx", ".jsx"):
        pw_inputs_missing_complete = []
        for m in re.finditer(r'<\s*input\b', content):
            pos = m.start()
            tag_body = _jsx_tag_body(content, pos, 1024)
            if re.search(r'type\s*=\s*["\x60\']password["\x60\']', tag_body, re.IGNORECASE):
                if not re.search(r'autocomplet', tag_body, re.IGNORECASE):
                    if not _is_comment(content, pos):
                        pw_inputs_missing_complete.append(f"L{_line_of(content, pos)}")
        if pw_inputs_missing_complete:
            sev = _sev('missing-input-autocomplete', 'warn')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('missing-input-autocomplete', sev,
                        f"Found {len(pw_inputs_missing_complete)} password input(s) missing autocomplete "
                        f"({', '.join(pw_inputs_missing_complete[:8])}"
                        f"{'...' if len(pw_inputs_missing_complete) > 8 else ''}). "
                        f"Add autocomplete=\"current-password\" (login/signin), "
                        f"autocomplete=\"new-password\" (registration/change), or "
                        f"autocomplete=\"off\" if this is a one-time-code or non-credential field."
                    )
                )

    # Check 26: Permissive or disabled Supabase/Postgres row-level security
    # policies in SQL migrations — ERROR. "Vibe-coded" Supabase apps commonly
    # ship a policy like `USING (true)` (meant as a placeholder to "get it
    # working") that grants every row to every anon-key holder, or an explicit
    # DISABLE ROW LEVEL SECURITY left in from local debugging. This is a
    # static, git-visible signal only: it can't see policies that were
    # changed via the Supabase dashboard rather than a checked-in migration,
    # so it's a first line of defense, not a substitute for a live probe.
    if file_path.suffix == '.sql':
        rls_findings = []
        for m in re.finditer(r'\bUSING\s*\(\s*true\s*\)', content, re.IGNORECASE):
            rls_findings.append(f"L{_line_of(content, m.start())}:USING(true)")
        for m in re.finditer(r'\bWITH\s+CHECK\s*\(\s*true\s*\)', content, re.IGNORECASE):
            rls_findings.append(f"L{_line_of(content, m.start())}:WITH CHECK(true)")
        if rls_findings:
            sev = _sev('rls-permissive-policy', 'error')
            if sev != 'off':
                (errors if sev == 'error' else warnings).append(
                    Finding('rls-permissive-policy', sev,
                        f"Found {len(rls_findings)} row-level security policy condition(s) that allow "
                        f"unconditional access: {', '.join(rls_findings[:8])}"
                        f"{'...' if len(rls_findings) > 8 else ''}. "
                        f"USING (true) / WITH CHECK (true) let anyone holding the anon key read or write "
                        f"every row in the table. Scope the condition to the requesting user, e.g. "
                        f"USING (auth.uid() = user_id).")
                )
        disable_matches = list(re.finditer(r'\bDISABLE\s+ROW\s+LEVEL\s+SECURITY\b', content, re.IGNORECASE))
        if disable_matches:
            sev = _sev('rls-disabled', 'error')
            if sev != 'off':
                lines = [f"L{_line_of(content, m.start())}" for m in disable_matches]
                (errors if sev == 'error' else warnings).append(
                    Finding('rls-disabled', sev,
                        f"Found {len(disable_matches)} DISABLE ROW LEVEL SECURITY statement(s) "
                        f"({', '.join(lines[:8])}). This turns off all row-level access control for the "
                        f"table, exposing every row to anyone with the anon/public API key. Remove it "
                        f"unless the table is genuinely meant to be fully public.")
                )

    # Check 27: Supabase service_role key hardcoded in source — ERROR.
    # The service_role JWT bypasses row-level security entirely. It is meant
    # to stay server-side only (env var / secrets manager); pasting it into
    # frontend code or committing it exposes full unrestricted DB access to
    # anyone who reads the bundle. Detected by decoding the JWT payload
    # (no network call, no dependency) and checking for role=service_role,
    # so it only fires on an actual key, not on the word "service_role".
    if file_path.suffix in TEXT_EXTENSIONS and file_path.suffix != '.md' and not is_test_file:
        for m in re.finditer(r'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}', content):
            token = m.group(0)
            parts = token.split('.')
            if len(parts) != 3:
                continue
            try:
                payload_raw = parts[1]
                padded = payload_raw + '=' * (-len(payload_raw) % 4)
                payload = json.loads(base64.urlsafe_b64decode(padded))
            except Exception:
                continue
            if payload.get('role') == 'service_role':
                sev = _sev('supabase-service-role-key-exposed', 'error')
                if sev != 'off':
                    line_num = _line_of(content, m.start())
                    (errors if sev == 'error' else warnings).append(
                        Finding('supabase-service-role-key-exposed', sev,
                            f"L{line_num}: Supabase service_role key found hardcoded in source. "
                            f"This key bypasses row-level security completely. Move it to a "
                            f"server-only environment variable, remove it from this file, and "
                            f"rotate the key in the Supabase dashboard immediately.")
                    )
                    break  # one finding per file is enough signal

    return errors, warnings

def check_html_file(file_path: Path, is_prod: bool = False):
    errors = []
    warnings = []
    
    try:
        content = file_path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return errors, warnings

    parser = SimpleHTMLInspector()
    try:
        parser.feed(content)
    except Exception as e:
        warnings.append(Finding('html-parse-error', "warn", f"HTML parsing failed: {e}"))
        return errors, warnings

    # Default Vite + React title check
    if "vite + react" in parser.title.lower():
        errors.append(Finding('default-title', "error", f"Default framework page title detected: '{parser.title.strip()}'"))

    # Emoji check — strip script/style/svg blocks to avoid false positives in data URIs
    text_only = re.sub(r"<(script|style|svg)\b[^>]*>.*?</\1>", "", content, flags=re.DOTALL | re.IGNORECASE)
    text_only = re.sub(r"<[^>]+>", "", text_only)  # Strip all remaining HTML tags
    emoji_matches = EMOJI_PATTERN.findall(text_only)
    if emoji_matches:
        unique = list(dict.fromkeys(emoji_matches))[:5]  # First 5 unique
        shown = " ".join(unique)
        if len(emoji_matches) > 5:
            shown += f" (+{len(emoji_matches) - 5} more)"
        errors.append(Finding('emoji-in-ui', "error", f"Emoji characters found in content ({len(emoji_matches)} total): {shown}. Use SVG icons instead."))

    # Title length check (rule 24: max 24 chars, ideal 12-18)
    title_stripped = parser.title.strip()
    if len(title_stripped) > 24:
        errors.append(
            Finding('long-title', "error",
                f"Page title too long ({len(title_stripped)} chars): '{title_stripped}'. "
                f"Keep titles under 24 characters (ideal 12-18). Browser tabs truncate at ~26."
            )
        )

    # Heading hierarchy check
    if parser.h1_count == 0:
        errors.append(Finding('missing-h1', "error", "Missing <h1> primary heading element."))
    elif parser.h1_count > 1:
        warnings.append(Finding('multiple-h1', "warn", f"Multiple <h1> elements found ({parser.h1_count}). Consider using a single <h1> per page."))

    # Missing alt text
    if parser.images_missing_alt > 0:
        errors.append(Finding('img-no-alt-html', "error", f"Found {parser.images_missing_alt} <img> element(s) with missing or empty alt text."))

    # Broken '#' buttons
    if parser.broken_hash_buttons > 0:
        errors.append(Finding('broken-buttons', "error", f"Found {parser.broken_hash_buttons} interactive button/link(s) with dead href='#' target."))

    # SEO & Metadata
    if not parser.has_lang:
        errors.append(Finding('missing-lang', "error", "Missing 'lang' attribute on <html> element."))

    if not parser.has_meta_desc:
        if is_prod:
            errors.append(Finding('missing-meta-desc', "error", "Missing <meta name='description'> tag."))
        else:
            warnings.append(Finding('missing-meta-desc', "warn", "Missing <meta name='description'> tag."))

    if not parser.has_og_image:
        warnings.append(Finding('missing-og-image', "warn", "Missing <meta property='og:image'> social preview tag."))

    if not parser.has_favicon:
        errors.append(Finding('missing-favicon', "error", "Missing <link rel='icon'> favicon tag."))
    elif parser.is_default_favicon:
        errors.append(Finding('default-favicon', "error", "Default Vite/React framework favicon detected ('vite.svg' or default placeholder icon). Replace with a custom project icon."))

    if is_prod and not parser.has_canonical:
        warnings.append(Finding('missing-canonical', "warn", "Missing <link rel='canonical'> tag."))

    return errors, warnings

def scan_directory(target_dir: Path, is_prod: bool = False, fix: bool = False,
                   changed_only: bool = False, use_cache: bool = True,
                   json_mode: bool = False, quiet: bool = False,
                   attr_findings: list = None):
    if not quiet:
        print(f"\n{BOLD}{CYAN}🔍 Running Vibe-Check on:{RESET} {target_dir.resolve()}\n")

    # Reset per-scan deduplication state
    global _seen_project_warnings
    _seen_project_warnings = set()

    # Load project config (.vibecheckrc or .vibe-check.json)
    config = _load_config(target_dir)

    total_errors = 0
    total_warnings = 0
    scanned_files = 0   # every file the report covers (freshly scanned + replayed)
    cached_files = 0    # subset of the above that came back from cache
    all_findings = []  # accumulated for --json output

    # ── Claude Code attribution settings check ─────────────────────────────────
    # Findings are pre-computed in main() to avoid double-calling for directory
    # mode. Catches the root cause of AI co-author trailers: Claude Code's
    # attribution.commit setting in ~/.claude/settings.json.
    if attr_findings is None:
        attr_findings = []
    for f in attr_findings:
        if f.severity == 'error':
            total_errors += 1
        else:
            total_warnings += 1
        if json_mode:
            all_findings.append(f.to_dict())
        if not quiet:
            print(f"  {RED}✖ [ERROR]{RESET} {f}" if f.severity == 'error' else f"  {YELLOW}⚠ [WARN]{RESET}  {f}")

    # ── Cache ──────────────────────────────────────────────────────────────────
    # Holds findings, not just "was scanned" — see the _load_findings_cache notes.
    _remove_legacy_cache(target_dir)
    cache = _load_findings_cache(target_dir, config, is_prod) if use_cache else {}
    # Seeded from the old cache so a partial run (--changed) does not discard
    # entries for files it never walked. Dead paths are pruned at save time.
    next_cache = dict(cache)

    # ── Git-aware file list (--changed) ────────────────────────────────────────
    changed_file_set = None
    if changed_only:
        try:
            result = subprocess.run(
                ["git", "diff", "--name-only", "--diff-filter=ACM", "HEAD"],
                capture_output=True, text=True, cwd=str(target_dir), timeout=10,
            )
            if result.returncode == 0 and result.stdout.strip():
                changed_file_set = set()
                for line in result.stdout.strip().split('\n'):
                    p = (target_dir / line.strip()).resolve()
                    if p.is_file():
                        changed_file_set.add(str(p))
                if not quiet: print(f"  {CYAN}git-aware:{RESET} {len(changed_file_set)} changed file(s) detected")
            else:
                if not quiet: print(f"  {YELLOW}git-aware:{RESET} no changes or not a repo — falling back to full scan")
        except Exception:
            if not quiet: print(f"  {YELLOW}git-aware:{RESET} git not available — falling back to full scan")

    # ── File walking ───────────────────────────────────────────────────────────
    has_privacy = False
    has_terms = False
    has_sitemap = False
    has_llms_txt = False

    for root, dirs, files in os.walk(target_dir):
        dirs[:] = [d for d in dirs if d not in EXCLUDE_DIRS and not d.startswith(".")]

        for file in files:
            file_path = Path(root) / file
            rel_path = file_path.relative_to(target_dir)

            # Check structural files
            file_lower = file.lower()
            if "privacy" in file_lower:
                has_privacy = True
            if "terms" in file_lower or "toc" in file_lower:
                has_terms = True
            if file_lower == "sitemap.xml":
                has_sitemap = True
            if file_lower == "llms.txt":
                has_llms_txt = True

            # Check exposed source maps
            if file.endswith(".map") and ("dist" in str(rel_path) or "public" in str(rel_path)):
                total_errors += 1
                if json_mode:
                    all_findings.append(Finding('exposed-source-maps', 'error',
                        "Exposed source map file in production build output.",
                        file=str(rel_path)).to_dict())
                if not quiet:
                    print(f"{RED}✖ [ERROR]{RESET} {rel_path}: Exposed source map file in production build output.")

            if file_path.suffix not in TEXT_EXTENSIONS:
                continue

            # Git-aware filtering: skip unchanged files when --changed is active
            if changed_file_set is not None and str(file_path.resolve()) not in changed_file_set:
                continue

            # Cache check: replay findings for files whose hash hasn't changed.
            # Note this REPLAYS rather than skips — a cached file still reports
            # its errors, so the verdict is the same with and without the cache.
            file_hash = None
            entry = None
            if use_cache and not fix:
                try:
                    file_hash = hashlib.sha256(file_path.read_bytes()).hexdigest()
                except Exception:
                    pass
                if file_hash:
                    candidate = cache.get(str(file_path))
                    if isinstance(candidate, dict) and candidate.get("hash") == file_hash:
                        entry = candidate

            scanned_files += 1

            if entry is not None:
                restored = [Finding.from_dict(d) for d in entry.get("findings", [])]
                file_errors = [f for f in restored if f.severity == 'error']
                file_warnings = [f for f in restored if f.severity != 'error']
                cached_files += 1
            else:
                # Content checks
                content_errors, content_warnings = check_file_content(file_path, fix=fix, config=config)

                # HTML specific checks
                html_errors, html_warnings = [], []
                if file_path.suffix in (".html", ".htm"):
                    html_errors, html_warnings = check_html_file(file_path, is_prod=is_prod)

                file_errors = content_errors + html_errors
                file_warnings = content_warnings + html_warnings

                # Stamp file path on all findings
                for f in file_errors + file_warnings:
                    f.file = str(rel_path)

            if json_mode:
                all_findings.extend(f.to_dict() for f in file_errors)
                all_findings.extend(f.to_dict() for f in file_warnings)

            total_errors += len(file_errors)
            total_warnings += len(file_warnings)

            if (file_errors or file_warnings) and not quiet:
                print(f"{BOLD}📄 {rel_path}{RESET}")
                for err in file_errors:
                    print(f"  {RED}✖ [ERROR]{RESET} {err}")
                for warn in file_warnings:
                    print(f"  {YELLOW}⚠ [WARN]{RESET}  {warn}")

            # Store this file's findings so the next run replays them verbatim.
            if use_cache and file_hash and entry is None:
                rules = {f.rule for f in file_errors + file_warnings}
                if rules & _UNCACHEABLE_RULES:
                    # Project-wide deduplicated finding: must be re-derived each
                    # run so the dedup set is rebuilt in walk order.
                    next_cache.pop(str(file_path), None)
                else:
                    next_cache[str(file_path)] = {
                        "hash": file_hash,
                        "findings": [f.to_dict() for f in file_errors + file_warnings],
                    }

    # ── Save cache ──────────────────────────────────────────────────────────
    if use_cache and not fix:
        pruned = {p: e for p, e in next_cache.items() if Path(p).is_file()}
        _save_findings_cache(target_dir, pruned, config, is_prod)

    # Situational checks
    if is_prod:
        prod_findings = []
        if not has_privacy:
            prod_findings.append(Finding('missing-privacy-policy', 'warn', "No Privacy Policy file/route detected."))
        if not has_terms:
            prod_findings.append(Finding('missing-terms', 'warn', "No Terms & Conditions file/route detected."))
        if not has_sitemap:
            prod_findings.append(Finding('missing-sitemap', 'warn', "No sitemap.xml detected."))
        if not has_llms_txt:
            prod_findings.append(Finding('missing-llms-txt', 'warn', "No llms.txt detected."))

        if prod_findings:
            total_warnings += len(prod_findings)
            if json_mode:
                all_findings.extend(f.to_dict() for f in prod_findings)
            if not quiet:
                print(f"\n{BOLD}🌐 Production Mode Checks:{RESET}")
                for f in prod_findings:
                    print(f"  {YELLOW}⚠ [WARN]{RESET}  {f}")

    # Project-level webhook signature verification check.
    # If any file in the project is a webhook handler but NO file
    # in the project contains signature verification, warn.
    webhook_files_found = []
    verification_files_found = []
    for root, dirs, files in os.walk(target_dir):
        dirs[:] = [d for d in dirs if d not in EXCLUDE_DIRS and not d.startswith(".")]
        for file in files:
            fp = Path(root) / file
            if fp.suffix not in TEXT_EXTENSIONS:
                continue
            try:
                fc = fp.read_text(encoding="utf-8", errors="ignore")
            except Exception:
                continue
            # Check for webhook route patterns
            if any(re.search(pat, fc, re.IGNORECASE) for pat in [
                r'(?:app|router|@app)\.(?:post|get|put|delete|use)\s*\(\s*["\x60\'][^"\x60\']*webhook',
                r'@(?:app|router)\.(?:post|get|put|delete|route)\s*\(\s*["\x60\'][^"\x60\']*webhook',
            ]):
                webhook_files_found.append(fp)
            # Check for signature verification (collected from any file)
            if any(re.search(pat, fc, re.IGNORECASE) for pat in [
                r'constructEvent', r'timingSafeEqual', r'compare_digest',
                r'createHmac.*update.*digest', r'hmac\.new\(.*digest',
            ]):
                verification_files_found.append(fp)

    if webhook_files_found and not verification_files_found:
        total_warnings += 1
        if json_mode:
            all_findings.append(Finding('unsigned-webhooks-project', 'warn',
                f"Project has {len(webhook_files_found)} webhook handler(s) but no HMAC signature verification found anywhere in the project.").to_dict())
        if not quiet:
            print(f"\n{BOLD}🔒 Security Checks:{RESET}")
            print(f"  {YELLOW}⚠ [WARN]{RESET}  Project has {len(webhook_files_found)} webhook handler(s) but no HMAC signature verification found anywhere in the project.")

    # ── Git commit integrity check ───────────────────────────────────────────
    # AI assistants sneak into commits via Co-Authored-By trailers, which is a
    # dead giveaway of vibecoded code. Check recent commit messages for
    # Claude/Anthropic/GPT/Gemini/Copilot/Codex contributor trails.
    ai_trailer_count = 0
    try:
        result = subprocess.run(
            ["git", "log", "--format=%b", "-50"],
            capture_output=True, text=True, cwd=str(target_dir), timeout=10,
        )
        if result.returncode == 0:
            ai_pattern = re.compile(
                r'^Co-Authored-By:.*(?:Claude|Anthropic|GPT|ChatGPT|Gemini|Copilot|Codex)',
                re.IGNORECASE | re.MULTILINE
            )
            ai_matches = ai_pattern.findall(result.stdout)
            ai_trailer_count = len(ai_matches)
            if ai_matches:
                total_errors += ai_trailer_count
                if json_mode:
                    all_findings.append(Finding('ai-co-author-trailers', 'error',
                        f"Found {ai_trailer_count} AI co-author trailer(s) in git commit history. "
                        f"Commits include patterns like: {ai_matches[0].strip()}. "
                        f"Run 'vibe-check --setup' to prevent future occurrences and "
                        f"'scrub-ai-contributors' to clean existing history.").to_dict())
                if not quiet:
                    print(f"\n{BOLD}🔒 Security Checks:{RESET}")
                    print(f"  {RED}✖ [ERROR]{RESET} Found {ai_trailer_count} AI co-author trailer(s) in git commit history.")
                    print(f"         Commits include patterns like: {ai_matches[0].strip()}")
                    print(f"         Run {BOLD}vibe-check --setup{RESET} to prevent future occurrences and {BOLD}scrub-ai-contributors{RESET} to clean existing history.")
    except Exception:
        pass  # Not a git repo or git unavailable — skip

    # ── Missing-hook warning ────────────────────────────────────────────────
    # If this is a git repo but no commit-msg hook is installed (per-repo or
    # global), nudge the user to run --setup (which covers hooks + more).
    # Rule 51 above is detection-only; --setup is the prevention path.
    if not quiet:
        hook_info = _check_commit_msg_hook(target_dir)
        if hook_info["status"] == "not_installed":
            print(f"\n  {YELLOW}💡 Tip:{RESET} No commit-msg hook installed. AI co-author trailers can still land in commits.")
            print(f"         Run {BOLD}vibe-check --setup{RESET} to audit and fix all prevention layers.")

    if json_mode:
        _emit_json(all_findings, total_errors, total_warnings, scanned_files, cached_files)

    if not quiet:
        print(f"\n{BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{RESET}")
        cache_note = f" ({cached_files} restored from cache)" if cached_files else ""
        print(f"Scanned {scanned_files} file(s){cache_note}.")

        if total_errors > 0:
            print(f"{RED}{BOLD}FAILED:{RESET} {total_errors} error(s), {total_warnings} warning(s) found.\n")
        elif total_warnings > 0:
            print(f"{YELLOW}{BOLD}PASSED WITH WARNINGS:{RESET} {total_warnings} warning(s).\n")
        else:
            print(f"{GREEN}{BOLD}PASSED:{RESET} 100% Clean! Zero anti-slop red flags found.\n")
    sys.exit(1 if total_errors > 0 else 0)

def _emit_json(findings, total_errors, total_warnings, scanned_files, cached_files=0):
    """Emit findings as a machine-readable JSON object to stdout.

    `findings` is a list of dicts (from Finding.to_dict()) or Finding objects.
    `scanned` counts every file the report covers, including cache replays, so
    it never disagrees with `findings`. `cached` is how many of those were
    replayed rather than re-read.
    """
    items = []
    for f in findings:
        if isinstance(f, Finding):
            items.append(f.to_dict())
        else:
            items.append(f)
    result = {
        "status": "failed" if total_errors > 0 else ("warn" if total_warnings > 0 else "ok"),
        "scanned": scanned_files,
        "cached": cached_files,
        "errors": total_errors,
        "warnings": total_warnings,
        "findings": items,
    }
    print(json.dumps(result))


def install_hooks(target_dir, global_hooks=False, server_mode=False):
    """Install git hooks that prevent AI co-author trailers from being committed.

    Without --global: installs a commit-msg hook in target_dir/.git/hooks/
    With --global: sets up a global git hooks directory via core.hooksPath.
    With --server: installs pre-receive hook to all bare repos under target_dir.

    Returns True if hooks were installed/updated, False on error.
    """
    hook_path = None

    if server_mode:
        # Install pre-receive hook to all bare git repos under target_dir
        bare_repos = list(target_dir.glob("*.git"))
        if not bare_repos:
            print(f"{RED}✖{RESET} No bare git repositories found in {target_dir}")
            print(f"  Bare repos are directories ending in .git (e.g. myproject.git)")
            return False
        installed = 0
        for repo in sorted(bare_repos):
            if not (repo / "hooks").is_dir():
                continue
            hook_path = repo / "hooks" / "pre-receive"
            hook_path.write_text(_PRE_RECEIVE_HOOK, encoding="utf-8")
            try:
                hook_path.chmod(0o755)
            except (OSError, NotImplementedError):
                pass
            installed += 1
        print(f"{GREEN}✔{RESET} Pre-receive hook installed to {installed} bare repo(s) under {target_dir}")
        print(f"  Pushes containing AI co-author trailers will be rejected server-side.")
        print(f"  This cannot be bypassed with git commit --no-verify.")
        print(f"  Emergency bypass (server admin): VIBE_CHECK_ALLOW=1")
        return True

    if global_hooks:
        hooks_dir = Path.home() / ".config" / "git" / "hooks"
        hooks_dir.mkdir(parents=True, exist_ok=True)
        hook_path = hooks_dir / "commit-msg"
        try:
            subprocess.run(
                ["git", "config", "--global", "core.hooksPath", str(hooks_dir)],
                capture_output=True, text=True, timeout=10,
            )
            print(f"{GREEN}✔{RESET} Global git hooks directory set to: {hooks_dir}")
        except Exception as exc:
            print(f"{RED}✖{RESET} Could not set global core.hooksPath: {exc}")
            return False
    else:
        git_dir = target_dir / ".git"
        if not git_dir.is_dir():
            # Check if this is a worktree (the .git is a file pointing to the real dir)
            try:
                result = subprocess.run(
                    ["git", "rev-parse", "--git-dir"],
                    capture_output=True, text=True, cwd=str(target_dir), timeout=10,
                )
                git_dir = Path(result.stdout.strip())
            except Exception:
                pass
            if not git_dir.is_dir():
                print(f"{RED}✖{RESET} Not a git repository (or .git not found). Run inside a git repo.")
                return False
        hooks_dir = git_dir / "hooks"
        hooks_dir.mkdir(parents=True, exist_ok=True)
        hook_path = hooks_dir / "commit-msg"

    # Check if an existing hook is one of ours
    if hook_path.exists():
        existing = hook_path.read_text(encoding="utf-8", errors="replace")
        if "Installed by vibe-check" in existing:
            # Our hook already — overwrite to update
            pass
        else:
            # Someone else's hook — back it up
            backup = Path(str(hook_path) + ".bak")
            backup.write_text(existing, encoding="utf-8")
            print(f"  {YELLOW}⚠{RESET}  Existing commit-msg hook backed up to {backup.name}")

    hook_path.write_text(_COMMIT_MSG_HOOK, encoding="utf-8")

    # Make executable. On Windows os.chmod only affects the read-only
    # attribute; Git for Windows determines executability by file content
    # (the #!/bin/sh shebang), so the hook works regardless.
    try:
        hook_path.chmod(0o755)
    except (OSError, NotImplementedError):
        pass  # Windows: chmod doesn't set execute bits, but git still runs the hook

    scope = "Global" if global_hooks else "Repository"
    print(f"{GREEN}✔{RESET} {scope} commit-msg hook installed: {hook_path}")
    print(f"  AI co-author trailers (Claude, GPT, Gemini, Copilot, Codex)")
    print(f"  will now be blocked at commit time.")
    print(f"  Requirements: git (Git for Windows on Windows).")
    print(f"  Emergency bypass: git commit --no-verify")
    return True

def _check_attribution_settings(fix=False):
    """Check if Claude Code attribution settings leave AI co-author trailers enabled.

    Claude Code appends Co-Authored-By trailers by default via the platform's
    Bash tool description. The root-cause fix is setting attribution.commit
    and attribution.pr to empty strings in ~/.claude/settings.json.

    Returns list of Finding objects. With --fix, automatically corrects the
    settings so AI trailers are never appended.
    """
    settings_path = Path.home() / ".claude" / "settings.json"
    if not settings_path.is_file():
        return []  # Claude Code not installed — nothing to check

    try:
        raw = settings_path.read_text(encoding="utf-8")
        settings = json.loads(raw)
    except (json.JSONDecodeError, OSError):
        return []

    attribution = settings.get("attribution", {})
    if not isinstance(attribution, dict):
        attribution = {}

    commit_val = attribution.get("commit")
    pr_val = attribution.get("pr")

    issues = []
    if commit_val is None:
        issues.append("commit (missing)")
    elif commit_val != "":
        issues.append(f"commit={commit_val!r}")

    if pr_val is None:
        issues.append("pr (missing)")
    elif pr_val != "":
        issues.append(f"pr={pr_val!r}")

    if not issues:
        return []  # Both already set to empty string — clean

    if fix:
        if "attribution" not in settings:
            settings["attribution"] = {}
        settings["attribution"]["commit"] = ""
        settings["attribution"]["pr"] = ""
        try:
            formatted = json.dumps(settings, indent=2, ensure_ascii=False)
            # Preserve trailing newline if the original had one
            if raw.endswith("\n"):
                formatted += "\n"
            settings_path.write_text(formatted, encoding="utf-8")
            return [Finding('claude-attribution', 'warn',
                "Fixed Claude Code attribution settings: commit and pr set to empty string. "
                "AI co-author trailers will no longer be appended to commits or PRs.",
                fixable=True)]
        except OSError:
            return [Finding('claude-attribution', 'error',
                f"Could not write to {settings_path}. Check file permissions.")]

    return [Finding('claude-attribution', 'warn',
        f"Claude Code attribution settings allow AI co-author trailers: {', '.join(issues)}. "
        f"Run 'vibe-check --fix' to set them to empty, or edit ~/.claude/settings.json: "
        f'{{"attribution": {{"commit": "", "pr": ""}}}}',
        fixable=True)]


def _check_commit_msg_hook(target_dir):
    """Check if a vibe-check commit-msg hook is installed (per-repo or global).

    Returns a dict: {status, detail, fix?}
    Status is one of: 'installed', 'not_installed', 'no_git'
    """
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--git-dir"],
            capture_output=True, text=True, cwd=str(target_dir), timeout=10,
        )
        if result.returncode != 0:
            return {"status": "no_git", "detail": "Not a git repository (or git unavailable)"}

        git_dir = Path(result.stdout.strip())
        repo_hook = git_dir / "hooks" / "commit-msg"
        global_hook = Path.home() / ".config" / "git" / "hooks" / "commit-msg"
        global_hooks_set = False

        try:
            r2 = subprocess.run(
                ["git", "config", "--get", "core.hooksPath"],
                capture_output=True, text=True, cwd=str(target_dir), timeout=10,
            )
            if r2.returncode == 0 and r2.stdout.strip():
                global_hook = Path(r2.stdout.strip()) / "commit-msg"
                global_hooks_set = True
        except Exception:
            pass

        hook_installed = (repo_hook.is_file() and
                          "Installed by vibe-check" in repo_hook.read_text(encoding="utf-8", errors="replace"))
        global_installed = global_hook.is_file() and global_hooks_set

        if hook_installed:
            return {"status": "installed", "detail": f"Per-repo hook at {repo_hook}"}
        elif global_installed:
            return {"status": "installed", "detail": f"Global hook at {global_hook}"}
        else:
            return {"status": "not_installed",
                    "detail": "No vibe-check commit-msg hook installed",
                    "fix": "vibe-check --install-hooks"}
    except Exception:
        return {"status": "no_git", "detail": "Git unavailable or not found"}


def _check_pre_receive_hooks(target_dir):
    """Check if pre-receive hooks are installed on bare repos under target_dir.

    Returns a dict: {status, detail, fix?}
    Status: 'installed', 'needs_fix', 'not_applicable'
    """
    try:
        candidates = list(target_dir.glob("*.git"))
    except (OSError, PermissionError):
        return {"status": "not_applicable", "detail": "Cannot scan for bare repos (permission error)"}

    # Filter to actual bare repos: must have HEAD + objects + refs at top level,
    # and core.bare must be true (or absent in ancient repos — the structure check is enough).
    bare_repos = []
    for c in candidates:
        if not c.is_dir():
            continue
        if c.name == ".git":
            continue  # Regular repo's own .git dir, not a bare repo
        # Bare repos have HEAD, objects/, refs/ at the top level
        if (c / "HEAD").is_file() and (c / "objects").is_dir() and (c / "refs").is_dir():
            bare_repos.append(c)

    if not bare_repos:
        return {"status": "not_applicable",
                "detail": "No bare git repos detected on this machine",
                "fix": "vibe-check --install-hooks --server <dir> (run on your git server)"}

    total = 0
    with_hook = 0
    for repo in bare_repos:
        if not (repo / "hooks").is_dir():
            continue
        total += 1
        hook = repo / "hooks" / "pre-receive"
        try:
            if hook.is_file() and "Installed by vibe-check" in hook.read_text(encoding="utf-8", errors="replace"):
                with_hook += 1
        except (OSError, PermissionError):
            pass

    if total == 0:
        return {"status": "not_applicable", "detail": "No bare repos with hooks directories found"}

    if with_hook == total:
        return {"status": "installed",
                "detail": f"Pre-receive hook installed on all {total} bare repo(s)"}
    else:
        missing = total - with_hook
        return {"status": "needs_fix",
                "detail": f"Pre-receive hook installed on {with_hook}/{total} bare repo(s), {missing} missing",
                "fix": "vibe-check --install-hooks --server " + str(target_dir)}


def run_setup(target_dir, json_mode=False):
    """Audit the machine for AI co-author trailer prevention layers.

    With --json: outputs structured JSON for AI agent consumption,
                 exits 1 if any layer needs attention.
    Without --json: interactive wizard that prompts for each fix.
    """
    checks = []

    # 1. Claude Code attribution settings
    attr_findings = _check_attribution_settings(fix=False)
    settings_path = Path.home() / ".claude" / "settings.json"
    if attr_findings:
        checks.append({
            "id": "claude-attribution",
            "status": "needs_fix",
            "detail": str(attr_findings[0]),
            "fix": "vibe-check --fix",
            "auto_fixable": True,
        })
    elif settings_path.is_file():
        checks.append({
            "id": "claude-attribution",
            "status": "ok",
            "detail": "attribution settings correct: commit=\"\" pr=\"\"",
        })
    else:
        checks.append({
            "id": "claude-attribution",
            "status": "not_applicable",
            "detail": "~/.claude/settings.json not found (Claude Code may not be installed)",
        })

    # 2. Git commit-msg hook
    hook_status = _check_commit_msg_hook(target_dir)
    checks.append({
        "id": "commit-msg-hook",
        **hook_status,
        "auto_fixable": hook_status.get("status") == "not_installed",
    })

    # 3. Pre-receive hook (server-side)
    pre_receive = _check_pre_receive_hooks(target_dir)
    checks.append({
        "id": "pre-receive-hook",
        **pre_receive,
        "auto_fixable": pre_receive.get("status") == "needs_fix",
    })

    # ── JSON mode: structured output for AI agents ──────────────────────
    if json_mode:
        needs_attention = any(
            c["status"] in ("needs_fix", "not_installed", "error") for c in checks
        )
        output = {
            "status": "needs_attention" if needs_attention else "ok",
            "checks": checks,
        }
        print(json.dumps(output, indent=2, ensure_ascii=False))
        sys.exit(1 if needs_attention else 0)

    # ── Interactive mode ────────────────────────────────────────────────
    print(f"\n{BOLD}  vibe-check setup{RESET}")
    print(f"  {'─' * 52}\n")

    icon_map = {"ok": "✓", "installed": "✓", "needs_fix": "⚠", "not_installed": "⚠",
                "not_applicable": "—", "error": "✖", "no_git": "—"}
    color_map = {"ok": GREEN, "installed": GREEN, "needs_fix": YELLOW, "not_installed": YELLOW,
                 "not_applicable": "", "error": RED, "no_git": ""}

    any_fixed = False
    for c in checks:
        st = c["status"]
        icon = icon_map.get(st, "?")
        color = color_map.get(st, "")
        print(f"  {color}{icon}{RESET} {c['id']}: {c['detail']}")

        if c.get("fix") and c.get("auto_fixable"):
            if sys.stdin.isatty():
                try:
                    answer = input(f"    Fix? [Y/n] ").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    print()
                    break
                if answer in ("", "y", "yes"):
                    if c["id"] == "claude-attribution":
                        _check_attribution_settings(fix=True)
                    elif c["id"] == "commit-msg-hook":
                        install_hooks(target_dir, global_hooks=False, server_mode=False)
                    elif c["id"] == "pre-receive-hook":
                        install_hooks(target_dir, global_hooks=False, server_mode=True)
                    any_fixed = True
            else:
                print(f"    Run: {c['fix']}")

    print(f"\n  {'─' * 52}")
    if any_fixed:
        print(f"  {GREEN}✓{RESET} Fixes applied.")
    print(f"  Run {BOLD}vibe-check .{RESET} to scan your project.\n")


def main():
    parser = argparse.ArgumentParser(description="Vibe-Check: Automated anti-vibecoding and anti-slop linter.")
    parser.add_argument("path", nargs="?", default=".", help="Path to project directory or file (default: current directory)")
    parser.add_argument("--prod", action="store_true", help="Enable strict production checks (sitemaps, legal pages, canonical tags)")
    parser.add_argument("--fix", action="store_true", help="Automatically fix fixable errors (e.g. replace em-dashes with standard dashes)")
    parser.add_argument("--changed", action="store_true", help="Only scan files changed in git (vs HEAD). Falls back to full scan outside repos.")
    parser.add_argument("--no-cache", action="store_true", help="Disable file-hash caching (always re-scan every file)")
    parser.add_argument("--install-hooks", action="store_true", help="Install git commit-msg hook to block AI co-author trailers at commit time")
    parser.add_argument("--global", action="store_true", dest="global_hooks", help="With --install-hooks: install hooks globally (all repos)")
    parser.add_argument("--server", action="store_true", dest="server_mode", help="With --install-hooks: install pre-receive hook to all bare repos (server-side, cannot be bypassed)")
    parser.add_argument("--setup", action="store_true", help="Audit prevention layers (Claude attribution, git hooks). With --json: structured output for AI agents.")
    parser.add_argument("--json", action="store_true", dest="json_mode", help="Output findings as machine-readable JSON (for AI agent consumption)")
    parser.add_argument("--quiet", action="store_true", help="Suppress all human-readable output (use with --json for clean machine output)")

    args = parser.parse_args()
    target_path = Path(args.path)

    if args.install_hooks:
        if not install_hooks(target_path, global_hooks=args.global_hooks,
                             server_mode=args.server_mode):
            sys.exit(1)
        return  # hooks installed, don't scan

    if args.setup:
        run_setup(target_path, json_mode=args.json_mode)
        return  # setup complete, don't scan

    if not target_path.exists():
        print(f"{RED}Error:{RESET} Target path '{target_path}' does not exist.")
        sys.exit(1)

    # ── Claude Code attribution settings check ─────────────────────────────────
    # Runs once regardless of scan mode. Catches the root cause of AI co-author
    # trailers before they reach git: Claude Code's attribution.commit setting.
    attr_findings = _check_attribution_settings(fix=args.fix)

    if target_path.is_file():
        # Scan parent directory or single file
        errors, warnings = check_file_content(target_path, fix=args.fix)
        if target_path.suffix in (".html", ".htm"):
            he, hw = check_html_file(target_path, is_prod=args.prod)
            errors.extend(he)
            warnings.extend(hw)

        # Merge attribution findings
        for f in attr_findings:
            (errors if f.severity == 'error' else warnings).append(f)

        # Stamp file path on content findings (skip system-level attribution findings)
        rel = str(target_path.name)
        for f in errors + warnings:
            if f.rule != 'claude-attribution':
                f.file = rel

        if args.json_mode:
            _emit_json(errors + warnings, len(errors), len(warnings), 1)
            sys.exit(1 if errors else 0)

        if not args.quiet:
            for f in attr_findings:
                if f.severity == 'error':
                    print(f"{RED}✖ [ERROR]{RESET} {f}")
                else:
                    print(f"{YELLOW}⚠ [WARN]{RESET}  {f}")
            print(f"\n{BOLD}📄 {target_path}{RESET}")
            for err in errors:
                print(f"  {RED}✖ [ERROR]{RESET} {err}")
            for warn in warnings:
                print(f"  {YELLOW}⚠ [WARN]{RESET}  {warn}")
        sys.exit(1 if errors else 0)

    scan_directory(target_path, is_prod=args.prod, fix=args.fix,
                   changed_only=args.changed, use_cache=not args.no_cache,
                   json_mode=args.json_mode, quiet=args.quiet,
                   attr_findings=attr_findings)

if __name__ == "__main__":
    main()
