class Finding:
    """A single vibe-check finding — one rule violation or warning.

    Implements __str__ for backward-compatible human-readable display,
    and to_dict() for JSON serialization when --json is used.
    """
    __slots__ = ('rule', 'severity', 'message', 'line', 'fixable', 'file')

    def __init__(self, rule, severity, message, line=None, fixable=False, file=None):
        self.rule = rule          # kebab-case, e.g. "em-dashes"
        self.severity = severity  # "error" or "warn"
        self.message = message    # human-readable description
        self.line = line          # optional line number
        self.fixable = fixable    # can --fix handle this?
        self.file = file          # relative file path (set by scan loop)

    def __str__(self):
        prefix = f"L{self.line}: " if self.line is not None else ""
        return f"{prefix}{self.message}"

    def __repr__(self):
        return f"Finding({self.rule!r}, {self.severity!r}, {self.message!r})"

    def to_dict(self):
        d = {"rule": self.rule, "severity": self.severity, "message": self.message}
        if self.line is not None:
            d["line"] = self.line
        if self.fixable:
            d["fixable"] = True
        if self.file is not None:
            d["file"] = self.file
        return d

    @classmethod
    def from_dict(cls, d):
        """Rebuild a Finding from to_dict() output, so cached findings can be replayed."""
        return cls(
            d["rule"], d["severity"], d["message"],
            line=d.get("line"), fixable=d.get("fixable", False), file=d.get("file"),
        )

# ── Git commit-msg hook (installed by --install-hooks) ──────────────────────
# Embedded as a constant so vibe-check stays single-file. This hook blocks
# AI co-author trailers before they land in git history, closing the gap
# between after-the-fact detection (Rule 51) and actual prevention.
_COMMIT_MSG_HOOK = r"""#!/bin/sh
# Installed by vibe-check --install-hooks
# Prevents AI co-author trailers from entering git history.
#
# AI tools (Claude, GPT, Gemini, etc.) are tools, not co-authors.
# A "Co-Authored-By: Claude" trailer is a dead giveaway of vibecoded code.
# This hook blocks those commits before they happen — GitHub contributor
# caching makes retroactive cleanup much harder than upfront prevention.
#
# Global hooks (--global): this hook chains to per-repo .git/hooks/commit-msg
# after the AI check passes, so per-repo hooks aren't silently disabled.
#
# Emergency bypass: git commit --no-verify
# To uninstall: rm .git/hooks/commit-msg  (or rm ~/.config/git/hooks/commit-msg for global)

COMMIT_MSG_FILE="$1"

if [ ! -f "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

# --- Phase 1: Block AI co-author trailers ---
if grep -qiE '^Co-Authored-By:.*(Claude|Anthropic|GPT|ChatGPT|Gemini|Copilot|Codex)' "$COMMIT_MSG_FILE"; then
    cat >&2 << 'EOF'
╔══════════════════════════════════════════════════════════════╗
║  ❌ Commit rejected: AI co-author trailer detected          ║
║                                                             ║
║  Your commit message includes a "Co-Authored-By:" line      ║
║  referencing an AI tool (Claude, GPT, Gemini, etc.).        ║
